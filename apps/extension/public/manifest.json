{
  "manifest_version": 3,
  "name": "Snapdeck",
  "description": "Capture a whole web page and hand it to the Snapdeck app.",
  "version": "0.1.0",
  "permissions": ["activeTab", "scripting", "storage", "downloads"],
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "Capture full page",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
